{
  "_comment": "Настройки парсера. Парсер собирает объявления ШИРЕ дефолтного фильтра (чтобы на сайте можно было расширять фильтры), а сайт фильтрует уже в браузере. Ссылки поиска можно менять: откройте нужный поиск на сайте, скопируйте адрес и вставьте сюда. Пригороды на OLX ищутся поиском по названию посёлка (q-…): лишнее отсеется по config/locations.json. min_price отсекает аренду и опечатки. Ссылку поиска можно задать объектом {\"url\": ..., \"max_pages\": N} со своим лимитом страниц.",
  "min_price": 3000000,
  "max_price": 30000000,
  "delay_seconds": [
    2,
    5
  ],
  "drop_after_days": 4,
  "max_detail_requests_per_run": 120,
  "max_detail_minutes": 15,
  "krisha": {
    "enabled": true,
    "max_pages": 20,
    "search_urls": [
      "https://krisha.kz/prodazha/kvartiry/astana/?das[price][to]={max_price}&das[house.year][from]=2000",
      "https://krisha.kz/prodazha/kvartiry/akmolinskaja-oblast/?das[price][to]={max_price}"
    ]
  },
  "olx": {
    "enabled": true,
    "max_pages": 25,
    "search_urls": [
      "https://www.olx.kz/nedvizhimost/prodazha-kvartiry/astana/?search[filter_float_price:to]={max_price}",
      {
        "url": "https://www.olx.kz/nedvizhimost/prodazha-kvartiry/q-Косшы/?search[filter_float_price:to]={max_price}",
        "max_pages": 3
      },
      {
        "url": "https://www.olx.kz/nedvizhimost/prodazha-kvartiry/q-Ильинка/?search[filter_float_price:to]={max_price}",
        "max_pages": 3
      },
      {
        "url": "https://www.olx.kz/nedvizhimost/prodazha-kvartiry/q-Уркер/?search[filter_float_price:to]={max_price}",
        "max_pages": 3
      },
      {
        "url": "https://www.olx.kz/nedvizhimost/prodazha-kvartiry/q-Жибек-Жолы/?search[filter_float_price:to]={max_price}",
        "max_pages": 3
      },
      {
        "url": "https://www.olx.kz/nedvizhimost/prodazha-kvartiry/q-Коянды/?search[filter_float_price:to]={max_price}",
        "max_pages": 3
      },
      {
        "url": "https://www.olx.kz/nedvizhimost/prodazha-kvartiry/q-Пригородный/?search[filter_float_price:to]={max_price}",
        "max_pages": 3
      }
    ]
  }
}
